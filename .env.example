# NVIDIA hosted LLMs
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Personal candidate data (never commit these files)
MASTER_RESUME_PATH=./private/master_resume.txt
PROFILE_PATH=./private/profile.json

# Official company career-source configuration
OFFICIAL_SOURCES_PATH=./config/company_sources.json

# Output and local database
OUTPUT_DIR=./data/applications
JOB_APPLIER_DB=./data/job_applyer.db

# Discovery / matching
MAX_DETAIL_PAGES_PER_SOURCE=200
MIN_MATCH_SCORE=50
APPLY_TO_ALL_ELIGIBLE=true

# NVIDIA model IDs; override any stage as needed.
MODEL_EXTRACT=openai/gpt-oss-20b
MODEL_ANALYZE=z-ai/glm-5-3-flash
MODEL_MATCH=openai/gpt-oss-20b
MODEL_RESUME=z-ai/glm-5-3
MODEL_COVER_LETTER=z-ai/glm-5-3-flash
MODEL_FORM=openai/gpt-oss-20b
MODEL_FALLBACK=deepseek-ai/deepseek-v4.1-flash
